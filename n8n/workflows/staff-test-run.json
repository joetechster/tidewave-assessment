      "id": "01948b83-0001-7000-8000-000000000003",
      "name": "Templates Unavailable (502)"
    },
    {
      "parameters": {
        "jsCode": "// Same rules as the ops console API: approved templates only, declared variables only, required\n// variables present. The recipient is fixed; nothing in the request can change it.\nconst body = $('Webhook').first().json.body || {};\nconst templates = $input.all().map((i) => i.json);\nconst template = templates.find((t) => t.key === body.templateKey);\nconst input = body.variables && typeof body.variables === 'object' ? body.variables : {};\nlet error = null;\nconst variables = {};\nif (!template || template.status !== 'approved') {\n  error = 'Choose an approved template. Draft templates cannot be test-sent.';\n} else {\n  const missing = [];\n  for (const v of template.variables) {\n    const value = typeof input[v.name] === 'string' ? input[v.name].trim() : '';\n    if (value) variables[v.name] = value;\n    else if (v.required) missing.push(v.label);\n  }\n  if (missing.length) error = `Please fill in: ${missing.join(', ')}`;\n}\nreturn [{ json: { valid: error === null, error, templateKey: template?.key, variables, requestedBy: body.requestedBy || 'unknown' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ],
      "id": "01948b83-0001-7000-8000-000000000004",
      "name": "Validate Test Run"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Test Run Valid?-c",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1160,
        200
      ],
      "id": "01948b83-0001-7000-8000-000000000005",
      "name": "Test Run Valid?"
    },
    {
      "parameters": {
