      "id": "01948b82-0001-7000-8000-000000000002",
      "name": "Read Signed Payload"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signedPayload }}",
        "dataPropertyName": "computedSignature",
        "encoding": "hex"
