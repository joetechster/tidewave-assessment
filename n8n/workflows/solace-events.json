      "parameters": {
        "jsCode": "// The sender signs \"<t>.<raw body>\" (X-Tidewave-Signature: t=<unix>,v1=<hex>), so hash the exact\n// bytes received rather than re-serialised JSON.\nconst item = $input.first();\nconst header = String(item.json.headers['x-tidewave-signature'] || '');\nconst parts = Object.fromEntries(header.split(',').map((p) => p.trim().split('=')));\nconst raw = item.binary && item.binary.data\n  ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')\n  : '';\nreturn [{\n  json: {\n    timestamp: parts.t || '',\n    signature: parts.v1 || '',\n    signedPayload: `${parts.t || ''}.${raw}`,\n    event: item.json.body || {},\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
