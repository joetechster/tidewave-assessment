      "parameters": {
        "jsCode": "// Every Solace Avenue opt-in (artist page \"Artist\" or campaign page \"artist\") gets the Solace intro;\n// the source label is not used for routing. No consent or no address means no email.\nconst { eventId, data } = $input.first().json;\nconst email = String(data.email || '').trim().toLowerCase();\nconst campaignSlug = String(data.campaignSlug || '').trim();\nlet reason = null;\nif (data.consent !== true) reason = 'no marketing consent';\nelse if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) reason = 'no valid email address';\nelse if (data.artistSlug !== 'solace-avenue') reason = `unknown artist ${data.artistSlug}`;\nelse if (!/^[a-z0-9-]+$/.test(campaignSlug)) reason = 'no campaign';\nreturn [{\n  json: {\n    eventId,\n    send: reason === null,\n    reason,\n    to: email,\n    firstName: String(data.firstName || '').trim(),\n    campaignUrl: `http://localhost:7080/campaigns/${campaignSlug}`,\n    // Repeat opt-ins and redelivered events for the same person and campaign share one key.\n    dedupeKey: `solace-intro:${email}:${campaignSlug}`,\n  },\n}];"
      },
