        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1160,
        200
      ],
      "id": "01948b81-0001-7000-8000-000000000005",
      "name": "Signature Valid?"
    },
