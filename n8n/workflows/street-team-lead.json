    {
      "parameters": {
        "jsCode": "// Constant-time comparison of the received signature with the HMAC computed from the credential.\n// Deliveries are retried for up to ~45 minutes, so the timestamp window is generous; replays inside it\n// are stopped by the idempotency claims further down.\nconst crypto = require('crypto');\nconst MAX_AGE_SECONDS = 60 * 60;\nconst { timestamp, signature, computedSignature, event } = $input.first().json;\nconst received = Buffer.from(String(signature), 'hex');\nconst expected = Buffer.from(String(computedSignature), 'hex');\nlet reason = null;\nif (!signature || received.length !== expected.length || !crypto.timingSafeEqual(received, expected)) {\n  reason = 'invalid signature';\n} else if (!(Math.abs(Date.now() / 1000 - Number(timestamp)) <= MAX_AGE_SECONDS)) {\n  reason = 'signature timestamp outside the allowed window';\n}\nreturn [{ json: { valid: reason === null, reason, eventId: event.id || null, type: event.type || null, data: event.data || {} } }];"
      },
