    {
      "parameters": {
        "jsCode": "// Decide from the stored lead, not the event. Only screening invites get an email (EMAIL_BRIEFS §1);\n// this workflow never sets or announces any status such as active, hired or field ready.\nconst lead = $input.first().json;\nlet reason = null;\nif (lead.status !== 'screening_invite') reason = `status is ${lead.status}; no follow-up email`;\nelse if (lead.consent !== true) reason = 'no consent';\nelse if (!lead.email) reason = 'no email address';\nreturn [{\n  json: {\n    eventId: $('Check Signature').first().json.eventId,\n    send: reason === null,\n    reason,\n    leadId: lead.id,\n    to: String(lead.email || '').trim(),\n    firstName: String(lead.firstName || '').trim(),\n    dedupeKey: `street-team-prospect:${lead.id}`,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        420
